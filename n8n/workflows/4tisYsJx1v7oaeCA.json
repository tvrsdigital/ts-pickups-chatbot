      "parameters": {
        "jsCode": "const q = $json.callback_query;\nconst [acao, igsid] = String(q.data || '').split(':');\nconst autorizado =\n  String(q.from.id) === String($env.TELEGRAM_CHAT_ID) &&\n  ['off', 'on'].includes(acao) &&\n  /^\\d+$/.test(igsid || '');\nreturn {\n  json: {\n    autorizado, acao, igsid,\n    query_id: q.id,\n    chat_id: q.message.chat.id,\n    message_id: q.message.message_id,\n    texto: q.message.text,\n  },\n};"
      },
