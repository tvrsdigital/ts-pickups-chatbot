    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH h AS (\n  SELECT encode(sha256(convert_to($1::text || $3::text, 'UTF8')), 'hex') AS user_hash\n),\nd AS (\n  DELETE FROM optouts\n  WHERE $2::text = 'on' AND user_hash = (SELECT user_hash FROM h)\n)\nINSERT INTO optouts (user_hash, source)\nSELECT user_hash, 'atendente' FROM h WHERE $2::text = 'off'\nON CONFLICT (user_hash) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ [ $json.igsid, $json.acao, $env.HASH_SALT ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
