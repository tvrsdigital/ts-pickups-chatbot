    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst item = $input.first();\nconst recebida = item.json.headers['x-hub-signature-256'] || '';\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst calculada = 'sha256=' + crypto\n  .createHmac('sha256', $env.IG_APP_SECRET)\n  .update(raw)\n  .digest('hex');\n\n// comparação em tempo constante (evita ataques de temporização)\nconst a = Buffer.from(recebida);\nconst b = Buffer.from(calculada);\nconst valida = a.length === b.length && crypto.timingSafeEqual(a, b);\n\nreturn [{\n  json: {\n    assinatura_valida: valida,\n    body: JSON.parse(raw.toString('utf8')),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "e5a1e6e9-8d64-4497-a14e-22a9586d1b53",
      "name": "Validar Assinatura",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "const conta = $env.IG_ACCOUNT_ID;\nconst body = $input.first().json.body;\nconst eventos = [];\n\nfor (const entry of body.entry || []) {\n  const lista = [];\n  for (const m of entry.messaging || []) lista.push(m);                 // formato de DMs reais\n  for (const c of entry.changes || []) {                               // formato do botão Teste\n    if (c.field === 'messages') lista.push(c.value);\n  }\n\n  for (const e of lista) {\n    const msg = e.message;\n    if (!msg || !e.sender) continue;                                   // ignora leituras, reações etc.\n    if (msg.is_echo || e.sender.id === conta) continue;                // ignora eco das nossas respostas\n\n    eventos.push({\n      json: {\n        igsid: e.sender.id,\n        mid: msg.mid,\n        texto: msg.text || '',\n        payload: msg.quick_reply ? msg.quick_reply.payload : null,\n        anexos: (msg.attachments || []).length,\n        timestamp: e.timestamp,\n        t0: Date.now(),\n      },\n    });\n  }\n}\nreturn eventos;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
