      "parameters": {
        "method": "POST",
        "url": "={{ $env.TYPEBOT_URL }}/api/v1/sessions/{{ $('Abrir sessão').item.json.typebot_session }}/continueChat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"message\": {{ JSON.stringify($('Extrair eventos').item.json.payload || $('Extrair eventos').item.json.texto) }} }",
