      ],
      "id": "725a8d8b-4477-4a1d-b7c0-28f0928efc36",
      "name": "Montar Resposta"
    },
    {
      "parameters": {
        "jsCode": "const saida = [];\n\nfor (const item of $input.all()) {\n  const { igsid, textos, botoes, handoff, fim } = item.json;\n  const truncados = botoes.filter((b) => b.length > 20);\n\n  textos.forEach((texto, i) => {\n    const ultima = i === textos.length - 1;\n    const message = { text: texto };\n\n    // Botões (resposta rápida) só vão na última mensagem. Limite do título: 20 caracteres.\n    // O payload leva o rótulo completo: é ele que devolvemos ao Typebot.\n    if (ultima && botoes.length) {\n      message.quick_replies = botoes.map((b) => ({\n        content_type: 'text',\n        title: b.slice(0, 20),\n        payload: b,\n      }));\n    }\n\n    saida.push({\n      json: {\n        igsid,\n        ordem: i,\n        handoff,\n        fim,\n        titulos_truncados: truncados,\n        body: { recipient: { id: igsid }, message },\n      },\n    });\n  });\n}\n\nreturn saida;"
      },
