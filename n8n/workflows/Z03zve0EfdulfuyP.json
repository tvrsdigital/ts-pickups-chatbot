    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst ev = $('Extrair eventos').first().json;\nconst resp = $('Preparar envios').first().json;\n\n// identificador anonimizado: nunca gravamos o ID real em events\nconst user_hash = crypto\n  .createHash('sha256')\n  .update(ev.igsid + $env.HASH_SALT)\n  .digest('hex');\n\nlet event = 'message';              // texto livre\nif (resp.handoff) event = 'handoff';\nelse if (resp.fim) event = 'end';\nelse if (ev.payload) event = 'choice';\n\nreturn [{\n  json: {\n    user_hash,\n    event,\n    detail: ev.payload || '',       // só o rótulo do botão; o texto digitado NÃO é guardado\n    latency_ms: Date.now() - ev.t0,\n  },\n}];"
      },
