      "id": "df620fd7-fdf9-4638-a231-11e0693e05a1",
      "name": "Typebot continueChat",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ev = $('Extrair eventos').item.json;\nconst r = $json;\n\nconst INVALIDO = 'Invalid message. Please, try again.';\nconst MSG_INVALIDO = 'Não entendi. Por favor, toque em um dos botões abaixo.';\n\n// richText do Typebot: blocos com filhos; extrai só o texto\nconst textoDe = (nos) => (nos || [])\n  .map((n) => (n.text !== undefined ? n.text : textoDe(n.children)))\n  .join('');\nconst paragrafos = (rich) => (rich || []).map((b) => textoDe(b.children)).join('\\n');\n\nlet textos = [];\nfor (const m of r.messages || []) {\n  if (m.type === 'text' && m.content && m.content.richText) {\n    let t = paragrafos(m.content.richText).trim();\n    if (t === INVALIDO) t = MSG_INVALIDO;\n    if (t) textos.push(t);\n  }\n}\n\nlet handoff = false;\nlet fim = false;\nlet optout = false;\ntextos = textos\n  .map((t) => {\n    if (t.includes('[[HANDOFF]]')) handoff = true;\n    if (t.includes('[[END]]')) fim = true;\n    if (t.includes('[[OPTOUT]]')) { optout = true; fim = true; }\n    return t\n      .replace('[[HANDOFF]]', '')\n      .replace('[[END]]', '')\n      .replace('[[OPTOUT]]', '')\n      .trim();\n  })\n  .filter(Boolean);\n\nconst botoes = r.input && r.input.type === 'choice input'\n  ? r.input.items.map((i) => i.content).slice(0, 13)\n  : [];\n\nreturn { json: { igsid: ev.igsid, textos, botoes, handoff, fim, optout } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2352,
