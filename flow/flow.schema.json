{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fluxo do chatbot TS PickUps",
  "type": "object",
  "required": ["start", "nodes"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "type": "object" },
    "start": { "type": "string" },
    "nodes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": ["label", "next"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 20 },
              "next": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "produto": { "type": "string" },
        "next": { "type": "string" },
        "marker": { "enum": ["HANDOFF", "END", "OPTOUT"] }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["options"], "not": { "anyOf": [{ "required": ["next"] }, { "required": ["marker"] }, { "required": ["produto"] }] } },
        { "required": ["next"], "not": { "anyOf": [{ "required": ["options"] }, { "required": ["marker"] }] } },
        { "required": ["marker"], "not": { "anyOf": [{ "required": ["options"] }, { "required": ["next"] }, { "required": ["produto"] }] } }
      ]
    }
  }
}
